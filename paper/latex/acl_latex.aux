\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Construction pipeline for the leak-controlled (\texttt  {v3}) LUMIERE item set. Structured per-patient facts are extracted from LUMIERE, an LLM drafts multiple-choice items from those facts, and an automatic auditor flags any item that restates an upstream phase's correct answer, feeding violations back into the drafting prompt for up to eight retries. The domain-expert review pass that finalizes each item (Section~\ref {sec:lumiere}) is a separate, still-ongoing track and is not shown here.}}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig:lumiere-pipeline}{{2}{6}{Construction pipeline for the leak-controlled (\texttt {v3}) LUMIERE item set. Structured per-patient facts are extracted from LUMIERE, an LLM drafts multiple-choice items from those facts, and an automatic auditor flags any item that restates an upstream phase's correct answer, feeding violations back into the drafting prompt for up to eight retries. The domain-expert review pass that finalizes each item (Section~\ref {sec:lumiere}) is a separate, still-ongoing track and is not shown here}{figure.caption.11}{}}
